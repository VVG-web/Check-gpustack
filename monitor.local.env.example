# Локальная настройка для сборки: адрес шлюза GPUStack и ключ к нему.
#
# Скопируйте в monitor.local.env и впишите своё. Этот файл в .gitignore — в репозиторий
# он не уедет, и чужой контур вместе с кодом не опубликуется.
#
# Нужен только для того, чтобы build.command положил первую настройку. Всё то же самое
# можно вписать прямо в приложении: значок в строке меню → «Настройки…».

GPUSTACK_URL=https://шлюз.example.com/v1
GPUSTACK_KEY=
