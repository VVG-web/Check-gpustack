#!/bin/bash
# Собрать образ для установки: окно, где приложение перетаскивают в «Программы».
#
# Двойной клик — и рядом появится .dmg, который можно отдать коллеге или приложить к
# релизу на GitHub. Зависимостей нет: hdiutil входит в macOS.
set -e
cd "$(dirname "$0")"

APP="GPUStack Монитор.app"
[ -d "$APP" ] || ./build.command

# Версию берём из самого приложения, а не из отдельной строки в скрипте: два места
# расходятся всегда, и однажды образ уедет с чужим номером.
VER=$(defaults read "$PWD/$APP/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo "1.0")
DMG="Check-gpustack-$VER.dmg"
STAGE=$(mktemp -d)

echo "Готовлю образ версии $VER…"
cp -R "$APP" "$STAGE/"
# Ярлык «Программы» рядом с приложением — это и есть весь установщик: человек тянет одно
# в другое. Отдельная программа-установщик тут ничего не добавляет, а спрашивает пароль.
ln -s /Applications "$STAGE/Программы"

rm -f "$DMG"
hdiutil create -quiet -volname "GPUStack Монитор" -srcfolder "$STAGE" \
    -ov -format UDZO "$DMG"
rm -rf "$STAGE"

echo "Готово: $PWD/$DMG"
echo
echo "Открыть образ, перетащить приложение в «Программы» — и оно встанет как обычная"
echo "программа: в Launchpad, в Spotlight, в «Объекты входа»."
echo
echo "Если образ уедет по сети, на чужом маке macOS сначала откажется его открывать:"
echo "приложение подписано «для себя», а не сертификатом разработчика (spctl: rejected)."
echo "Обойти — один раз, после первой попытки запуска:"
echo "  Системные настройки → Конфиденциальность и безопасность → пролистать вниз →"
echo "  «Открыть всё равно»."
echo "Правый клик → «Открыть» на macOS 15 уже не помогает: этот обход убрали."
echo "Чтобы не требовалось вовсе, нужна платная учётная запись разработчика Apple и"
echo "нотаризация образа. Для приложения, собираемого на своей машине, это лишнее."
